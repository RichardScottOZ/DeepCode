# =============================================================
# DeepCode - API Keys Configuration
# =============================================================
# Copy this file to mcp_agent.secrets.yaml and fill in your keys.
#
# At least ONE LLM provider API key is required.
# Config file takes priority over environment variables.
# =============================================================

# OpenAI
openai:
  api_key: ""

# Anthropic (Claude)
anthropic:
  api_key: ""

# Google (Gemini)
google:
  api_key: ""

# OpenRouter (access multiple models via one key - https://openrouter.ai/keys)
openrouter:
  api_key: ""
